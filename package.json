{
  "name": "payloadflare",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "deploy": "pnpm run deploy:database && pnpm run deploy:app",
    "deploy:app": "opennextjs-cloudflare build --env=$CLOUDFLARE_ENV && opennextjs-cloudflare deploy --env=$CLOUDFLARE_ENV",
    "deploy:database": "NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate && wrangler d1 execute D1 --command 'PRAGMA optimize' --env=$CLOUDFLARE_ENV --remote",
    "dev": "NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && rm -rf .open-next && NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "pnpm run generate:types:cloudflare && pnpm run generate:types:payload",
    "generate:types:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:types:payload": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "pnpm install --ignore-workspace",
    "lint": "NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --env=$CLOUDFLARE_ENV",
    "start": "NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "@payloadflare/email-cloudflare": "workspace:*",
    "@payloadflare/versioned-filenames": "workspace:*",
    "@payloadcms/db-d1-sqlite": "catalog:",
    "@payloadcms/next": "catalog:",
    "@payloadcms/plugin-form-builder": "catalog:",
    "@payloadcms/richtext-lexical": "catalog:",
    "@payloadcms/storage-r2": "catalog:",
    "@payloadcms/ui": "catalog:",
    "graphql": "^16.14.2",
    "next": "catalog:",
    "payload": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "wrangler": "^4.127.1"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": "^11"
  },
  "cloudflare": {
    "bindings": {
      "PAYLOAD_SECRET": {
        "description": "Generate a random string using `openssl rand -hex 32`"
      }
    }
  }
}
