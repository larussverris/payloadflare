# A generated secret for Payload
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# The canonical public URL, without a path (for example, https://example.com)
NEXT_PUBLIC_SERVER_URL=

# Maximum upload size in bytes (required)
MAX_UPLOAD_SIZE=

# Transactional email sender (address must match the EMAIL binding's allowed senders)
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Auto-login as an existing user during development (leave blank to disable)
DEV_AUTO_LOGIN_EMAIL=
